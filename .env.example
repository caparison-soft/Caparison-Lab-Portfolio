# ---- Supabase Postgres (Prisma) ----
# Supavisor pooler, port 6543. Runtime queries from serverless functions.
DATABASE_URL="postgresql://postgres.[ref]:[pw]@[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection, port 5432. Migrations and introspection only.
DIRECT_URL="postgresql://postgres.[ref]:[pw]@[region].pooler.supabase.com:5432/postgres"

# ---- Supabase Auth ----
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Never NEXT_PUBLIC_. Never imported into a client component.
SUPABASE_SERVICE_ROLE_KEY=""

# ---- Cloudflare R2 (S3 API, region "auto") ----
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="caparison-media"
# Custom domain bound to the bucket. Never the pub-*.r2.dev URL in production.
NEXT_PUBLIC_CDN_URL="https://cdn.caparisonlab.com"

# ---- Resend ----
RESEND_API_KEY=""
# Verified sender, e.g. "Caparison Lab <hello@caparisonlab.com>"
RESEND_FROM=""
# Where enquiry notifications go.
INQUIRY_NOTIFY_EMAIL=""
# Optional. Svix signing secret from the Resend webhook settings.
RESEND_WEBHOOK_SECRET=""

# ---- App ----
NEXT_PUBLIC_SITE_URL="https://caparisonlab.com"
# Bearer token Vercel Cron sends to /api/cron/*. 32+ random characters.
CRON_SECRET=""
# Signs "preview as visitor" links for draft projects. 32+ random characters.
DRAFT_PREVIEW_SECRET=""
